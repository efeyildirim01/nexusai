# Copy to api/.env for local development. Never commit real secrets.
# Runtime connection: the non-owner role. Row-Level Security applies to it.
NEXUS_DATABASE_URL=postgresql+psycopg://nexus_app:nexus_app_dev@localhost:5432/nexusai
# Migrations only: the role that owns the tables.
NEXUS_MIGRATIONS_DATABASE_URL=postgresql+psycopg://nexus_owner:nexus_owner_dev@localhost:5432/nexusai
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXUS_JWT_SECRET=change-me-change-me-change-me-change-me-change-me
NEXUS_CORS_ORIGINS=["http://localhost:3000"]
